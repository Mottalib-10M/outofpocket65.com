---
/** Every page of `src/content/pages/` with a version in this language sits at /es/<slug>/. */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/guides';
import type { PageDef } from '../../lib/guide-types';
export function getStaticPaths() {
  return PAGES.filter((p) => p.es).map((page) => ({ params: { slug: page.es!.slug }, props: { page } }));
}
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} lang="es" />
