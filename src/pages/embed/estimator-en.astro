---
/** Embeddable estimator (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import Estimator from '../../components/calc/Estimator';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { ACTS } from '../../lib/estimate';
const acts = ACTS.map((a) => a.id);
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Medicare cost estimator (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${route('home', 'en')}`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <Estimator client:load lang="en" act="office-visit" acts={acts} idPrefix="w" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}${route('home', 'en')}`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a></p>
  </body>
</html>
